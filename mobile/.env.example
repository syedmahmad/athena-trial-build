# ---------------------------------------------------------------------------
# Athena mobile shell — copy to `.env` and fill in. All values are inlined at
# build time (EXPO_PUBLIC_*), so they must be public/publishable, never secret.
# ---------------------------------------------------------------------------

# Web app the WebView loads. Leave blank to use production
# (https://athena.sset.dev). For a dev build against your local Next.js server,
# use your machine's LAN IP — a device cannot reach `localhost`:
#   EXPO_PUBLIC_WEB_URL=http://192.168.1.20:3001
EXPO_PUBLIC_WEB_URL=

# Supabase public values — used ONLY for the native Google sign-in round-trip.
# Copy straight from the web app's .env:
#   NEXT_PUBLIC_SUPABASE_URL                     -> EXPO_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY -> EXPO_PUBLIC_SUPABASE_ANON_KEY
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
